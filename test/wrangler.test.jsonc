{
  "name": "mailsentry-test",
  "main": "entry.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "mailsentry-test", "migrations_dir": "../migrations" }],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "mailsentry-test-raw" }],
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true }]
}
