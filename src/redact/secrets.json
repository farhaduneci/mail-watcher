{
  "$comment": "Secret-token regexes adapted from gitleaks (config/gitleaks.toml, MIT, https://github.com/gitleaks/gitleaks) and secretlint preset-recommend (MIT, https://github.com/secretlint/secretlint). Converted from Go RE2 to JavaScript: inline (?i) became the flags field. Keep patterns linear: no nested quantifiers.",
  "rules": [
    { "id": "private-key", "pattern": "-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----[\\s\\S]{64,8000}?-----END[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----" },
    { "id": "aws-access-key", "pattern": "\\b(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16}\\b" },
    { "id": "github-pat", "pattern": "\\bgh[pousr]_[0-9a-zA-Z]{36}\\b" },
    { "id": "github-fine-grained-pat", "pattern": "\\bgithub_pat_[0-9a-zA-Z_]{82}\\b" },
    { "id": "gitlab-pat", "pattern": "\\bglpat-[0-9a-zA-Z_-]{20}\\b" },
    { "id": "openai-key", "pattern": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}" },
    { "id": "openai-legacy-key", "pattern": "\\bsk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20}\\b" },
    { "id": "anthropic-key", "pattern": "\\bsk-ant-(?:api|admin)\\d{2}-[a-zA-Z0-9_-]{80,}" },
    { "id": "slack-token", "pattern": "\\bxox[abposr]-[0-9A-Za-z-]{10,}" },
    { "id": "slack-webhook", "pattern": "https://hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9+/_-]{20,}" },
    { "id": "stripe-key", "pattern": "\\b(?:sk|rk|pk)_(?:test|live|prod)_[0-9a-zA-Z]{10,99}\\b" },
    { "id": "google-api-key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "gcp-service-account", "pattern": "\"type\": ?\"service_account\"" },
    { "id": "jwt", "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{10,}" },
    { "id": "npm-token", "pattern": "\\bnpm_[a-zA-Z0-9]{36}\\b" },
    { "id": "pypi-token", "pattern": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}" },
    { "id": "sendgrid-key", "pattern": "\\bSG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43}\\b" },
    { "id": "mailgun-key", "pattern": "\\bkey-[0-9a-f]{32}\\b" },
    { "id": "twilio-key", "pattern": "\\bSK[0-9a-fA-F]{32}\\b" },
    { "id": "telegram-bot-token", "pattern": "\\b\\d{8,10}:AA[0-9A-Za-z_-]{33}\\b" },
    { "id": "discord-webhook", "pattern": "https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]{30,}" },
    { "id": "shopify-token", "pattern": "\\bshp(?:at|ca|pa|ss)_[a-fA-F0-9]{32}\\b" },
    { "id": "digitalocean-token", "pattern": "\\bdo[opr]_v1_[a-f0-9]{64}\\b" },
    { "id": "huggingface-token", "pattern": "\\bhf_[a-zA-Z]{34}\\b" },
    { "id": "cloudflare-origin-ca-key", "pattern": "\\bv1\\.0-[a-f0-9]{24}-[a-f0-9]{146}\\b" },
    { "id": "atlassian-token", "pattern": "\\bATATT3[A-Za-z0-9_=-]{180,}" },
    { "id": "database-url", "pattern": "\\b(?:postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|amqps?)://[^\\s:@/]{1,100}:[^\\s@/]{1,200}@[^\\s/]{1,200}" },
    { "id": "basic-auth-url", "pattern": "\\bhttps?://[^\\s:@/]{1,100}:[^\\s@/]{3,200}@[^\\s/]{1,200}" },
    { "id": "generic-assignment", "pattern": "\\b(?:api[_-]?key|secret|token|passw(?:or)?d|pwd)[\"']?\\s{0,3}[:=]\\s{0,3}[\"']?[A-Za-z0-9_\\-+/=.!@#$%^&*]{8,200}", "flags": "i" }
  ]
}
